{
  "schemaId": "agent.semantic-protocols.provider-core-manifest",
  "schemaVersion": "1",
  "languageId": "rust",
  "providerId": "asp-rust",
  "displayName": "Rust",
  "extensions": [".rs"],
  "projectMarkers": ["Cargo.toml"],
  "syntaxSurface": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"],
    "delimiterPairs": [["(", ")"], ["[", "]"], ["{", "}"]],
    "statementTerminator": ";",
    "stringDelimiters": ["\""]
  },
  "transport": {
    "transport": "http-json",
    "command": ["serve"],
    "healthPath": "/health",
    "requestPath": "/v1/provider-runtime",
    "shutdownPath": "/shutdown"
  },
  "capabilities": {
    "astInspect": true,
    "astVerify": true,
    "openEdb": true,
    "projectResolution": true
  }
}
