{
  "$schema": "../schemas/provider-workspace-install.schema.json",
  "schemaId": "agent.semantic-protocols.provider-workspace-install",
  "schemaVersion": "1",
  "schemaAuthority": "https://tao3k.github.io/agent-semantic-protocols/schemas/",
  "languageId": "rust",
  "providerId": "asp-rust",
  "binary": "asp-rust",
  "providerRegistration": "asp-provider-registration.json",
  "schemaBundleReceipt": "../schemas/.asp-schema-manager-receipt.json",
  "workspaceArtifact": {
    "root": "languages/asp-rust/target/release/asp-rust",
    "entrypoint": "."
  },
  "workspaceBuild": {
    "program": "just",
    "args": [
      "install"
    ],
    "workingDirectory": "languages/asp-rust",
    "sourceSnapshotAnchors": [
      "languages/asp-rust/Justfile",
      "languages/asp-rust/Cargo.toml",
      "languages/asp-rust/Cargo.lock"
    ],
    "derivedPaths": [
      "languages/asp-rust/target"
    ],
    "env": {}
  }
}
